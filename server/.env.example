APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Banco: forma local (campos separados, sem SSL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chamados
DB_USER=chamados
DB_PASSWORD=chamados
# SSL do Postgres: disable (local) | require (Neon/produção).
# Se omitido, é inferido: ligado quando há DATABASE_URL, senão desligado.
DB_SSL_MODE=disable

# --- Banco: forma em nuvem (tem prioridade sobre os DB_* acima) ---
# Cole a connection string do Neon aqui para apontar local -> Neon.
# DATABASE_URL=postgresql://user:senha@ep-xxx.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=troque-em-producao
JWT_EXPIRATION_HOURS=8

LOG_LEVEL=INFO

# --- Bootstrap do admin de produção (tool/create_admin.dart) ---
# ADMIN_LOGIN=admin
# ADMIN_SENHA=troque-esta-senha
# ADMIN_NOME=Administrador
# ADMIN_EMAIL=admin@uems.br
# ADMIN_SETOR=TI
